# Database Configuration
# Local PostgreSQL or Neon connection string
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/repo_intelligence
DATABASE_POOLED_URL=postgresql://postgres:postgrespassword@localhost:5432/repo_intelligence

# AI Providers (required: there is no mock fallback; the app fails loudly if these are missing)
# Options: "mistral", "openai". Mistral's free API tier works for both the LLM and embeddings.
LLM_PROVIDER=mistral
LLM_API_KEY=your_mistral_api_key_here
LLM_MODEL=ministral-8b-latest

# Embedding Provider (web app and worker must use the same provider and dimensions)
# Options: "mistral" (always 1024 dims), "openai" (text-embedding-3-*, shortened to EMBEDDING_DIMENSIONS).
# EMBEDDING_DIMENSIONS must match the vector column created by the migrations.
EMBEDDING_PROVIDER=mistral
EMBEDDING_API_KEY=your_mistral_api_key_here
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

# Safety & Processing Limits
MAX_REPOSITORY_SIZE_MB=100
MAX_FILE_SIZE_KB=500
MAX_TOTAL_TEXT_MB=20
MAX_FILES=2000

# Worker Tuning
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LOCK_TIMEOUT_MINUTES=10
MAX_JOB_ATTEMPTS=3

# GitHub API Token (Optional, for higher rate limits on public GitHub repos)
GITHUB_TOKEN=

# Discovery sources (worker connector gateway). deps.dev, OSV, npm, crates.io and arXiv need no key.
# Tavily finds pages on a project's own docs site; without it only the linked homepage is read.
TAVILY_API_KEY=
# Optional: raises the Stack Exchange quota from 300 to 10,000 requests per day
STACKEXCHANGE_KEY=
# Optional: render docs pages through the scraper service (e.g. http://127.0.0.1:8001); plain HTTP otherwise
WORKER_SCRAPER_URL=

# Internal Secrets
INTERNAL_API_SECRET=dev-secret-key-1234
