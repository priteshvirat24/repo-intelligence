# Node dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
out/
build/
# ...except the build-mode API route (/api/briefs/[id]/build), which is source
!apps/web/app/api/briefs/\[id\]/build/
*.tsbuildinfo

# Python virtual environment & cache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Repositories scratch and clones
scratch/
clones/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db

# Workspace packages are consumed as TypeScript source; never commit compiled output next to it
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# Turborepo cache
.turbo/

# Evaluation: recorded responses and per-run work files (see eval/README.md)
eval/snapshots/
eval/work/
